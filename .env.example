# ============================================================================
# SPARKTRACK MONOREPO ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# Copy this file to `.env` and fill in your credentials.
# Never commit real credentials to `.env.example`.
# ============================================================================

# 1. SUPABASE POSTGRESQL 17 & AUTH
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. GOOGLE GEMINI / VERTEX AI (SPARKTRACK INTELLIGENCE)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
GEMINI_FAST_PARSER_MODEL="gemini-2.5-flash"
GEMINI_SYNTHESIS_ADVISOR_MODEL="gemini-2.5-pro"

# 3. UPSTASH REDIS (CACHE & BULLMQ EVENT QUEUES)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
UPSTASH_REDIS_API_KEY="your-upstash-redis-api-key"
REDIS_URL="rediss://default:your-upstash-redis-rest-token@your-instance.upstash.io:6379"

# 4. CLOUDFLARE R2 OBJECT STORAGE (ZERO-EGRESS PORTFOLIOS)
R2_ACCOUNT_ID="your-cloudflare-r2-account-id"
R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"
R2_BUCKET_NAME="sparktrack-evidence-artifacts"
R2_ENDPOINT="https://your-cloudflare-r2-account-id.r2.cloudflarestorage.com"
# NEXT_PUBLIC_R2_PUBLIC_DOMAIN="https://cdn.sparktrack.africa"

# 5. BILLING & PAYMENTS (NIGERIA FIRST + GLOBAL)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# 6. OBSERVABILITY
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxx"
SENTRY_DSN="https://xxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0"

# 7. API AUTH (verify Supabase access tokens; prefer JWKS if your project uses asymmetric signing keys)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://[PROJECT_REF].supabase.co/auth/v1"
CORS_ORIGIN="http://localhost:3000"

# 8. PARENTAL CONSENT SMS (Termii) & ADMIN BOOTSTRAP
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="SparkTrack"
CONSENT_OTP_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
ADMIN_REGISTRATION_SECRET="replace-with-a-random-operator-secret-of-at-least-32-bytes"
CONSENT_VERIFICATION_URL="http://localhost:3000/parent/consent"
