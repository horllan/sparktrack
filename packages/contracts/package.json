{
  "name": "@sparktrack/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./evidence": { "types": "./dist/evidence/index.d.ts", "default": "./dist/evidence/index.js" },
    "./intelligence": { "types": "./dist/intelligence/index.d.ts", "default": "./dist/intelligence/index.js" },
    "./learner": { "types": "./dist/learner/index.d.ts", "default": "./dist/learner/index.js" },
    "./report": { "types": "./dist/report/index.d.ts", "default": "./dist/report/index.js" },
    "./common": { "types": "./dist/common/index.d.ts", "default": "./dist/common/index.js" }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@sparktrack/tsconfig": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
