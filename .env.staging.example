# ============================================================================
# SPARKTRACK STAGING ENVIRONMENT CONFIGURATION TEMPLATE (.env.staging.example)
# ============================================================================
# Stage 3 (Pre-Production Staging Sandbox)
# Never reuse production credentials or real minor PII in staging.
# ============================================================================

NODE_ENV=staging
PORT=4000
CORS_ORIGIN=https://staging.sparktrack.africa

# Isolated Staging PostgreSQL (Supabase Staging Project) & Redis
DATABASE_URL=postgresql://sparktrack_staging_app:REPLACE_WITH_STAGING_DB_PASSWORD@db.staging-project.supabase.co:5432/postgres
REDIS_URL=rediss://default:REPLACE_WITH_STAGING_REDIS_PASSWORD@staging-redis.upstash.io:6379

# Staging Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_STAGING_SUPABASE_JWT_SECRET_MIN_32_BYTES

# Staging Cryptographic Secrets (minimum 32 bytes each)
CONSENT_OTP_SECRET=REPLACE_WITH_32_BYTE_STAGING_CONSENT_HMAC_SECRET
ADMIN_REGISTRATION_SECRET=REPLACE_WITH_32_BYTE_STAGING_OPERATOR_BOOTSTRAP_SECRET

# Termii Sandbox SMS (NDPA Parental Consent OTP)
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_API_KEY=REPLACE_WITH_TERMII_SANDBOX_KEY
TERMII_SENDER_ID=SparkTrack

# Sandbox Payment Providers (Test Keys Only)
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_TEST_SECRET
STRIPE_WEBHOOK_SECRET=whsec_test_REPLACE_WITH_STRIPE_TEST_WEBHOOK_SECRET

# Staging Cloudflare R2 Evidence Bucket
R2_PUBLIC_ENDPOINT=https://staging-r2.sparktrack.africa
R2_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_R2_SIGNING_SECRET

# Gemini AI Synthesis (Fallback-safe if omitted)
GOOGLE_GENERATIVE_AI_API_KEY=REPLACE_WITH_STAGING_GEMINI_API_KEY

# Next.js Public Staging API Endpoint
NEXT_PUBLIC_API_URL=https://api-staging.sparktrack.africa/api

