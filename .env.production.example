# ============================================================================
# SPARKTRACK STAGE 4 PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ============================================================================
# Stage 4 (Live Production — Real Learner & Guardian NDPA Data)
# Requires Stage 3 (Staging) verification sign-off before promotion.
# ============================================================================

NODE_ENV=production
SPARKTRACK_STAGE=production
PORT=4000
CORS_ORIGIN=https://app.sparktrack.africa

# Production PostgreSQL 17 (Transaction Pooler on 6543 for Runtime, Direct 5432 for Migrations)
DATABASE_URL="postgresql://sparktrack_prod_app:REPLACE_WITH_PROD_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.PROD_REF:REPLACE_WITH_PROD_MIGRATION_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Production Supabase Auth (JWKS Asymmetric Verification Recommended)
NEXT_PUBLIC_SUPABASE_URL="https://PROD_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_PROD_PUBLISHABLE_KEY"
SUPABASE_JWKS_URL="https://PROD_REF.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://PROD_REF.supabase.co/auth/v1"

# Production Upstash Redis (TLS + REST)
UPSTASH_REDIS_REST_URL="https://prod-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_PROD_UPSTASH_REST_TOKEN"
REDIS_URL="rediss://default:REPLACE_WITH_PROD_UPSTASH_REST_TOKEN@prod-instance.upstash.io:6379"

# Production Cloudflare R2 Evidence Vault
R2_ACCOUNT_ID="REPLACE_WITH_PROD_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="REPLACE_WITH_PROD_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_PROD_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="sparktrack-evidence-artifacts-prod"

# Production Security & NDPA Consent Secrets (Minimum 32 Bytes — Stored in Secret Manager)
CONSENT_OTP_SECRET="REPLACE_WITH_64_BYTE_PRODUCTION_CONSENT_HMAC_SECRET"
ADMIN_REGISTRATION_SECRET="REPLACE_WITH_64_BYTE_PRODUCTION_OPERATOR_SECRET"
CONSENT_VERIFICATION_URL="https://app.sparktrack.africa/parent/consent"

# Live Termii SMS & Payment Gateways
TERMII_API_KEY="REPLACE_WITH_LIVE_TERMII_API_KEY"
TERMII_SENDER_ID="SparkTrack"
PAYSTACK_SECRET_KEY="sk_live_REPLACE_WITH_LIVE_PAYSTACK_SECRET"
STRIPE_WEBHOOK_SECRET="whsec_live_REPLACE_WITH_LIVE_STRIPE_WEBHOOK_SECRET"

# Gemini AI Synthesis
GOOGLE_GENERATIVE_AI_API_KEY="REPLACE_WITH_PRODUCTION_GEMINI_API_KEY"

# Next.js Public Production API Endpoint
NEXT_PUBLIC_API_URL="https://api.sparktrack.africa/api"

